# Copy to .env and fill in your values.
#
# MariaDB 10 on Synology. MariaDB uses the "mysql" connection scheme.
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@SYNOLOGY_HOST:3307/digital-hygiene"

# --- Auth.js (NextAuth v5) ---
# Generate a secret:  openssl rand -base64 33
AUTH_SECRET="change-me"
# App URL — must match the port you run on and the Google redirect URI below.
# PRODUCTION: set BOTH to the public https URL, e.g. AUTH_URL="https://digital-hygiene.example.org".
# It decides (a) whether the session cookie is "Secure"/"__Secure-" (an http:// value here means it
# is NOT, even if users connect over https), (b) the origin inside emailed sign-in links, and (c) the
# origin of the early 307 redirect in src/proxy.ts (no AUTH_URL → the proxy does nothing and the
# pages redirect themselves).
AUTH_URL="http://localhost:3003"
NEXTAUTH_URL="http://localhost:3003"

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials → OAuth client, "Web application").
# Authorized redirect URI (dev): http://localhost:3003/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# Resend (transactional email) — used for the "Guest" magic-link login.
# Get an API key at https://resend.com/api-keys. For local testing without a
# verified sending domain, Resend still delivers from onboarding@resend.dev,
# but only to the email address of the Resend account owner.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Must be an address on a domain verified in your Resend account (or the
# unverified default "onboarding@resend.dev" for local/test-only use).
EMAIL_FROM="Digital Hygiene <no-reply@yourdomain.example>"

# Optional: restrict sign-in to one Google Workspace domain (e.g. thaimooc.ac.th).
# Leave empty / unset to allow any Google account.
# ALLOWED_EMAIL_DOMAIN="thaimooc.ac.th"

# Comma-separated admin emails — only these may open /admin (checked server-side
# against the verified session email).
ADMIN_EMAILS="admin1@example.com, admin2@example.com"
